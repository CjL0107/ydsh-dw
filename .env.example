# ============================================================
# 环境变量示例文件
# 用法：cp .env.example .env  （.env 已被 .gitignore 忽略，不会提交）
# 注意：第 1 周的 docker-compose.yml 使用固定开发密码（root/root），
#      本文件主要用于第 3 周接入大模型 API 时管理密钥。
# ============================================================

# ---------- 数据库（第 1 周） ----------
MYSQL_ROOT_PASSWORD=root
METASTORE_DB=metastore

# ---------- 大模型 API（第 3 周 NL2SQL 用，现在留空即可） ----------
# 严禁把真实 Key 写进代码或提交到仓库
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 应用配置（第 4 周可视化用） ----------
SUPERSET_SECRET_KEY=
STREAMLIT_PORT=8501
