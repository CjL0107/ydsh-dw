# ============================================================
# 环境变量示例文件（第 4 周更新）
# 用法：
#   cp .env.example .env
#   然后填入真实密钥 —— .env 已被 .gitignore 忽略，不会提交
#
# 原则：编排文件（docker-compose.yml）里只写 ${VAR}，不写任何明文口令。
#      需要随机口令的项，可用下面这条命令生成：
#      python -c "import secrets;print(secrets.token_hex(12))"
# ============================================================

# ---------- 数据库（第 1 周 / 第 4 周） ----------
MYSQL_ROOT_PASSWORD=root
METASTORE_DB=metastore

# ---------- ClickHouse（第 4 周：查询优化对比 / 压测） ----------
# 必须显式设口令。不设的话默认用户无密码，会报 516 Authentication failed
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ydsh_ads

# ---------- Superset（第 4 周：仪表板） ----------
# SECRET_KEY 必填，缺失时 docker compose 会直接报错退出（故意这么设计）
SUPERSET_SECRET_KEY=
# 仅首次初始化时生效；已存在的 admin 账号不会被覆盖
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_PORT=8088

# ---------- 大模型 API（第 3 周 NL2SQL / 第 4 周 Streamlit 问答） ----------
# 严禁把真实 Key 写进代码或提交到仓库
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# ---------- 应用端口（第 4 周） ----------
APP_PORT=8000
STREAMLIT_PORT=8501
# ---------- 大屏刷新接口令牌（第 4 周） ----------
# POST /api/refresh 会触发一次 Hive 全量重算，建议设令牌；留空则不校验
REFRESH_TOKEN=
