<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tez 配置文件（项目自定义）

  为什么需要它：
    Hive 4 与 Tez 0.10 默认限制 DAG 计数器上限为 120 个 key，而本项目的数据质量
    扫描脚本大量使用 UNION ALL（几十个字段各产生计数器），执行时会报：
      ERROR: Counters limit exceeded: Too many counters: 121 max=120
    调大上限即可解决。

  为什么通过 Hive 层传参无效：
    在 beeline 中加 hiveconf 参数 tez.am.counters.max.keys=5000 不生效，因为 Hive
    不会把 tez 前缀的配置转发给 Tez AM，必须在 Tez 侧的 tez-site.xml 里定义。

  放置位置：
    镜像里 /opt/tez/conf 只有模板、没有 tez-site.xml；且 HADOOP_CLASSPATH 并不
    包含 /opt/tez/conf。因此本文件由 docker-compose 同时挂载到
      /opt/hive/conf/tez-site.xml   这是真正生效的位置（HIVE_CONF_DIR 在 classpath 上）
      /opt/tez/conf/tez-site.xml    保险用，便于排查

  注意：XML 注释中不能出现连续两个减号，否则解析直接失败（本文件已规避）。
-->
<configuration>
  <!-- 单个 counter group 下允许的最大 key 数量，默认 120 -->
  <property>
    <name>tez.am.counters.max.keys</name>
    <value>5000</value>
  </property>
  <!-- 允许的最大 counter group 数量，默认 500 -->
  <property>
    <name>tez.am.counters.max.groups</name>
    <value>1000</value>
  </property>
</configuration>
